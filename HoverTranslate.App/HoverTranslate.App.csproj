<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>HoverTranslate</AssemblyName>
    <Product>炫译</Product>
    <AssemblyTitle>炫译</AssemblyTitle>
    <Description>炫译 — 悬停与热键翻译</Description>
    <Version>1.0.1</Version>
    <ApplicationIcon>Assets\xuanyi.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\HoverTranslate.Core\HoverTranslate.Core.csproj" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\config.example.json" Link="config.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="Assets\xuanyi.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\docs\privacy.md" Link="docs\privacy.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\docs\terms.md" Link="docs\terms.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- dotnet publish 成功后自动刷新桌面「炫译.lnk」（仅 win-x64） -->
  <Target Name="RefreshDesktopShortcutAfterPublish"
          AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' == 'win-x64' and '$(RefreshDesktopShortcut)' != 'false'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\.."
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\scripts\create-desktop-shortcut.ps1&quot; -SkipPublish -NoKill" />
  </Target>
</Project>
