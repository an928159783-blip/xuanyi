<Window x:Class="HoverTranslate.App.Windows.HistoryPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="历史记录"
        Width="360" Height="400"
        MinWidth="260" MinHeight="160"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        LocationChanged="OnPlacementChanged"
        SizeChanged="OnPlacementChanged">
  <Border x:Name="RootBorder" CornerRadius="10" BorderBrush="#80313244" BorderThickness="1" Background="#E61e1e2e">
    <Grid x:Name="ResizeHost">
      <Grid.RowDefinitions>
        <RowDefinition Height="26"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Panel.ZIndex="10">
        <Border x:Name="DragHandle" Background="Transparent" Margin="0,0,100,0" Cursor="SizeAll"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,1,2,0" IsHitTestVisible="True">
          <Button x:Name="MinButton"/>
          <Button x:Name="MaxButton"/>
          <Button x:Name="CloseButton"/>
        </StackPanel>
      </Grid>
      <ScrollViewer x:Name="HistoryScroll" Grid.Row="1" Padding="12,0,12,8"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" FontSize="12"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="False"
                 HorizontalContentAlignment="Stretch"
                 SelectionChanged="OnHistorySelected">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="Padding" Value="6,4"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="Background" Value="#55313244"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#45475a"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding TargetPreview}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SourcePreview}" TextWrapping="Wrap" FontSize="10" Margin="0,4,0,0" Opacity="0.75">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Visible"/>
                      <Style.Triggers>
                        <Trigger Property="Text" Value="">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </ScrollViewer>
      <Grid x:Name="HistoryFooter" Grid.Row="2" Margin="12,4,12,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="HistoryCountText" Grid.Column="0" FontSize="10" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="OpenInTranslationButton" Content="打开" Margin="0,0,8,0" Padding="8,3" FontSize="11"
                  Click="OnOpenInTranslation"/>
          <Button Content="清空历史" Padding="8,3" FontSize="11" Click="OnClearHistory"/>
        </StackPanel>
      </Grid>
      <Border x:Name="ResizeRight" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="12"
              Background="Transparent" Panel.ZIndex="500"/>
      <Border x:Name="ResizeBottom" Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Height="12"
              Background="Transparent" Margin="0,0,12,0" Panel.ZIndex="500"/>
      <Border x:Name="ResizeCorner" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="16" Height="16"
              Background="Transparent" Panel.ZIndex="501"/>
    </Grid>
  </Border>
</Window>
