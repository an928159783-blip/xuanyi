<Window x:Class="HoverTranslate.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="炫译 设置"
        Width="760" Height="640"
        MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="White"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ShowInTaskbar="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/SettingsFrostTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
      <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
      <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsBodyText}"/>
      <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource SettingsFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="#1E293B"/>
        <Setter Property="Margin" Value="0,6"/>
      </Style>
      <Style TargetType="Button" BasedOn="{StaticResource FrostButton}"/>
      <Style TargetType="TextBox" BasedOn="{StaticResource FrostTextBox}"/>
      <Style TargetType="PasswordBox" BasedOn="{StaticResource FrostPasswordBox}"/>
      <Style TargetType="ComboBox" BasedOn="{StaticResource FrostComboBox}"/>
      <ContextMenu x:Key="OpenAiKeyHelpMenu">
        <MenuItem Header="DeepSeek 获取密钥" Tag="https://platform.deepseek.com/api_keys" Click="OnOpenKeyHelpLink"/>
        <MenuItem Header="阿里云百炼 获取密钥" Tag="https://dashscope.console.aliyun.com/apiKey" Click="OnOpenKeyHelpLink"/>
      </ContextMenu>
      <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FrostPrimaryButton}"/>
      <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource FrostDangerButton}"/>
      <Style x:Key="SectionBorder" TargetType="Border" BasedOn="{StaticResource FrostSectionBorder}"/>
    </ResourceDictionary>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 左侧导航 -->
    <Border Grid.Column="0" Grid.Row="0" Background="#F7F8FA" BorderBrush="#E8EDF5" BorderThickness="0,0,1,0">
      <DockPanel Margin="0,16,0,12">
        <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold" Margin="20,0,0,16" DockPanel.Dock="Top"/>
        <ListBox x:Name="NavList" Style="{StaticResource NavListBox}"
                 ItemContainerStyle="{StaticResource NavListItem}"
                 SelectionChanged="OnNavChanged" DockPanel.Dock="Top">
          <ListBoxItem Content="翻译接口" IsSelected="True"/>
          <ListBoxItem Content="浮窗"/>
          <ListBoxItem Content="热键与悬停"/>
          <ListBoxItem Content="通用"/>
          <ListBoxItem Content="隐私"/>
          <ListBoxItem Content="关于"/>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- 右侧内容 -->
    <Grid Grid.Column="1" Grid.Row="0" Background="White">
      <ScrollViewer x:Name="SettingsPageScroll" VerticalScrollBarVisibility="Auto" Padding="28,16,28,20">
        <Grid>
          <!-- 翻译接口 -->
          <StackPanel x:Name="PanelApi" Visibility="Visible">
            <TextBlock Text="翻译接口" Style="{StaticResource SettingPageTitle}" Margin="0,0,0,4"/>
            <TextBlock Style="{StaticResource SettingHintText}" Margin="0,0,0,8"
                       Text="API Key 仅保存在本机，仅向您配置的接口发送请求。"/>
            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8"
                    Padding="12,10" Margin="0,0,0,16">
              <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#1E40AF" LineHeight="18"
                         Text="数据与费用说明：待翻译文本会直接从本机发往您填写的接口地址（如 DeepSeek、Azure、Google）。使用境外节点可能涉及数据出境，API 调用费用由各服务商按量计费。若需境内链路，请优先选用阿里云百炼、Azure 中国区等，并查阅 SECURITY.md。"/>
            </Border>
            <Border Style="{StaticResource SectionBorder}">
              <StackPanel>
                <Grid Style="{StaticResource SettingFormRow}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="16"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource SettingToolbarLabelHost}">
                    <TextBlock Text="翻译通道" Style="{StaticResource SettingToolbarLabel}"/>
                  </Border>
                  <ComboBox x:Name="ProviderCombo" Grid.Column="2" Width="280"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            DisplayMemberPath="Label" SelectedValuePath="Id"
                            SelectionChanged="OnProviderChanged"/>
                </Grid>
                <TextBlock Text="Auto 将按顺序尝试已勾选且已填 Key 的接口。" Style="{StaticResource SettingSmallHint}" Margin="0,0,0,4"/>
                <TextBlock x:Name="ActiveProviderStatusText" Style="{StaticResource SettingSmallHint}" Margin="0,0,0,8"
                           TextWrapping="Wrap"/>
                <StackPanel x:Name="AutoPanel" Visibility="Collapsed">
                  <StackPanel x:Name="AutoProviderPanel"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SectionBorder}">
              <StackPanel>
                <Grid Style="{StaticResource SettingToolbarRow}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="16"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource SettingToolbarLabelHost}">
                    <TextBlock Text="添加 / 编辑接口" Style="{StaticResource SettingToolbarLabel}"/>
                  </Border>
                  <StackPanel Grid.Column="2" Style="{StaticResource SettingToolbarActions}">
                    <ComboBox x:Name="AddTemplateCombo" Width="220" Margin="0,0,8,0"
                              DisplayMemberPath="Label" SelectedValuePath="Kind" SelectionChanged="OnAddTemplateChanged"/>
                    <Button Content="+ 添加" Click="OnAddProfile"/>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="KindHintText" Style="{StaticResource SettingSmallHint}" Margin="0,0,0,8"/>
                <Border x:Name="ProfileListHost" Margin="0,0,0,8" Background="#F8FAFC" BorderBrush="#CBD5E1"
                        BorderThickness="1" CornerRadius="10"
                        PreviewMouseWheel="OnProfileListPreviewMouseWheel">
              <ListBox x:Name="ProfileList" MaxHeight="240"
                       Style="{StaticResource FrostListBox}"
                       Background="Transparent" BorderThickness="0"
                       ScrollViewer.VerticalScrollBarVisibility="Hidden"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ItemContainerStyle="{StaticResource FrostListBoxItem}"
                       SelectionChanged="OnProfileSelected"
                       ContextMenuOpening="OnProfileContextMenuOpening"
                       PreviewMouseWheel="OnProfileListPreviewMouseWheel">
                  <ListBox.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="删除此接口" Click="OnDeleteProfileFromContext"/>
                    </ContextMenu>
                  </ListBox.ContextMenu>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,2">
                          <TextBlock Text="{Binding PrimaryLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding SecondaryLabel}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                  <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                  </Trigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Content="×" Width="28" Height="28" Padding="0" Margin="4,0,0,0"
                                ToolTip="删除此接口" Tag="{Binding Profile}" Click="OnDeleteProfileFromList"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                FontSize="16" Foreground="#64748B"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
              </ListBox>
                </Border>
                <TextBlock Text="显示名称" Style="{StaticResource SettingFieldLabel}"/>
                <TextBox x:Name="ProfileNameBox" Margin="0,0,0,6" TextChanged="OnProfileEditorChanged"/>
                <TextBlock Text="接口类型" Style="{StaticResource SettingFieldLabel}"/>
                <TextBlock x:Name="ProfileTypeText" Margin="0,0,0,6" FontWeight="SemiBold" Foreground="#1E293B"/>
                <ComboBox x:Name="ProfileKindCombo" Margin="0,0,0,6" SelectionChanged="OnProfileKindChanged" Visibility="Collapsed"/>
                <TextBlock Text="API Key" Style="{StaticResource SettingFieldLabel}"/>
                <PasswordBox x:Name="ProfileKeyBox" Margin="0,0,0,6"/>
                <StackPanel x:Name="ProfileRegionPanel" Visibility="Collapsed">
                  <TextBlock Text="微软区域" Style="{StaticResource SettingFieldLabel}"/>
                  <TextBox x:Name="ProfileRegionBox" Margin="0,0,0,6"/>
                </StackPanel>
                <StackPanel x:Name="ProfileOpenAiPanel">
                  <TextBlock Text="Base URL" Style="{StaticResource SettingFieldLabel}"/>
                  <TextBox x:Name="ProfileUrlBox" Margin="0,0,0,6" TextChanged="OnProfileEditorChanged"/>
                  <TextBlock Text="模型名" Style="{StaticResource SettingFieldLabel}"/>
                  <TextBox x:Name="ProfileModelBox" Margin="0,0,0,6" TextChanged="OnProfileEditorChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <Button x:Name="KeyHelpButton" Content="获取 API Key ▾" Click="OnOpenProviderHelp"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- 浮窗（译文 + 历史） -->
          <StackPanel x:Name="PanelFloatWindows" Visibility="Collapsed">
            <TextBlock Text="浮窗" Style="{StaticResource SettingPageTitle}" Margin="0,0,0,4"/>
            <TextBlock Style="{StaticResource SettingHintText}" Margin="0,0,0,16"
                       Text="译文窗与历史窗的外观、行为及历史数据管理。"/>

            <TextBlock Text="译文窗" Style="{StaticResource SettingSectionHeader}" Margin="0,0,0,8"/>
            <Border Style="{StaticResource SectionBorder}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="显示与关闭" Style="{StaticResource SettingRowLabel}" Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource SettingSmallHint}" Margin="0,0,0,8" TextWrapping="Wrap"
                           Text="控制何时弹出译文窗，以及手动关闭后的行为。"/>
                <CheckBox x:Name="ShowPanelOnTranslateCheck" Margin="0,0,0,6" IsChecked="True">
                  <TextBlock TextWrapping="Wrap"
                             Text="热键 / 复制 / 选中翻译时在译文窗显示结果"/>
                </CheckBox>
                <CheckBox x:Name="ShowPanelOnHoverCheck" Margin="0,0,0,6">
                  <TextBlock TextWrapping="Wrap"
                             Text="悬停翻译时在译文窗显示结果（关闭时用右下角轻量浮层）"/>
                </CheckBox>
                <CheckBox x:Name="SuppressPanelAfterCloseCheck"
                          Margin="0,0,0,2" IsChecked="True">
                  <TextBlock TextWrapping="Wrap"
                             Text="手动关闭译文窗后，复制/选中/悬停不再自动翻译（热键仍可翻译；托盘「打开译文窗」恢复自动翻译）"/>
                </CheckBox>
                <TextBlock Style="{StaticResource SettingSmallHint}" Margin="16,0,0,6" TextWrapping="Wrap"
                           Text="需先手动关闭一次译文窗后生效；取消勾选或托盘打开译文窗后立即恢复。"/>
                <Grid Style="{StaticResource SettingFormRow}" Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="16"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource SettingToolbarLabelHost}">
                    <TextBlock Text="自动关闭 (秒，0=不关闭)" Style="{StaticResource SettingToolbarLabel}"/>
                  </Border>
                  <TextBox x:Name="OverlayTimeoutBox" Grid.Column="2" Width="100"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="外观" Style="{StaticResource SettingRowLabel}" Margin="0,16,0,4"/>
                <Grid Style="{StaticResource SettingFormRow}" Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="16"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource SettingToolbarLabelHost}">
                    <TextBlock Text="外观主题" Style="{StaticResource SettingToolbarLabel}"/>
                  </Border>
                  <ComboBox x:Name="TranslationThemeCombo" Grid.Column="2" Width="220"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            DisplayMemberPath="Label" SelectedValuePath="Id"/>
                </Grid>
                <TextBlock Text="不透明度" Style="{StaticResource SettingRowLabel}" Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource SettingSmallHint}" Margin="0,0,0,8"
                           Text="数值越大窗口越实（越不透明）；0% 几乎全透明。"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <Slider x:Name="TranslationOpacitySlider" Minimum="0" Maximum="100" Width="220"
                          IsSnapToTickEnabled="True" TickFrequency="1"/>
                  <TextBox x:Name="TranslationOpacityBox" Width="52" Margin="8,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource FrostCompactTextBox}" MaxLength="3"
                           LostFocus="OnTranslationOpacityBoxLostFocus"
                           PreviewKeyDown="OnOpacityBoxPreviewKeyDown"/>
                  <TextBlock Text="%" Style="{StaticResource SettingRowLabel}" Margin="4,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <Button Content="25%" Tag="25" Padding="8,4" Margin="0,0,6,0" Click="OnTranslationOpacityPreset"/>
                  <Button Content="50%" Tag="50" Padding="8,4" Margin="0,0,6,0" Click="OnTranslationOpacityPreset"/>
                  <Button Content="75%" Tag="75" Padding="8,4" Margin="0,0,6,0" Click="OnTranslationOpacityPreset"/>
                  <Button Content="90%" Tag="90" Padding="8,4" Click="OnTranslationOpacityPreset"/>
                </StackPanel>
                <Border x:Name="TranslationPreview" Height="56" CornerRadius="10" BorderThickness="1" Margin="0,0,0,12">
                  <TextBlock Text="预览" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <CheckBox x:Name="TranslationExtrasCheck" Content="显示附加项（状态栏）"
                          ToolTip="在译文窗底部显示原文预览、翻译状态（如「翻译中…」「翻译完成 · 接口名」）等附加信息；关闭后仅保留译文与复制按钮。"/>
              </StackPanel>
            </Border>

            <TextBlock Text="历史窗" Style="{StaticResource SettingSectionHeader}" Margin="0,0,0,8"/>
            <Border Style="{StaticResource SectionBorder}">
              <StackPanel>
                <Grid Style="{StaticResource SettingFormRow}" Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="16"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource SettingToolbarLabelHost}">
                    <TextBlock Text="外观主题" Style="{StaticResource SettingToolbarLabel}"/>
                  </Border>
                  <ComboBox x:Name="HistoryThemeCombo" Grid.Column="2" Width="220"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            DisplayMemberPath="Label" SelectedValuePath="Id"/>
                </Grid>
                <TextBlock Text="不透明度" Style="{StaticResource SettingRowLabel}" Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource SettingSmallHint}" Margin="0,0,0,8"
                           Text="数值越大窗口越实（越不透明）；0% 几乎全透明。"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <Slider x:Name="HistoryOpacitySlider" Minimum="0" Maximum="100" Width="220"
                          IsSnapToTickEnabled="True" TickFrequency="1"/>
                  <TextBox x:Name="HistoryOpacityBox" Width="52" Margin="8,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource FrostCompactTextBox}" MaxLength="3"
                           LostFocus="OnHistoryOpacityBoxLostFocus"
                           PreviewKeyDown="OnOpacityBoxPreviewKeyDown"/>
                  <TextBlock Text="%" Style="{StaticResource SettingRowLabel}" Margin="4,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <Button Content="25%" Tag="25" Padding="8,4" Margin="0,0,6,0" Click="OnHistoryOpacityPreset"/>
                  <Button Content="50%" Tag="50" Padding="8,4" Margin="0,0,6,0" Click="OnHistoryOpacityPreset"/>
                  <Button Content="75%" Tag="75" Padding="8,4" Margin="0,0,6,0" Click="OnHistoryOpacityPreset"/>
                  <Button Content="90%" Tag="90" Padding="8,4" Click="OnHistoryOpacityPreset"/>
                </StackPanel>
                <Border x:Name="HistoryPreview" Height="56" CornerRadius="10" BorderThickness="1" Margin="0,0,0,12">
                  <TextBlock Text="预览" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <CheckBox x:Name="HistoryExtrasCheck" Content="显示历史条数（复制请右键）"/>
                <CheckBox x:Name="EnableHistoryCheck" Content="保存翻译到本地历史（SQLite，仅存本机）"
                          Margin="0,12,0,0" Checked="OnHistoryToggleChanged" Unchecked="OnHistoryToggleChanged"/>
                <TextBlock Style="{StaticResource SettingSmallHint}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="导入/导出/清空仅在此处操作；历史浮窗底部仅保留「导出」快捷入口。"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button Content="导出历史" Margin="0,0,8,0" Click="OnExportHistory" ToolTip="TXT 可读可导入；JSON 为完整备份"/>
                  <Button Content="导入历史" Margin="0,0,8,0" Click="OnImportHistory" ToolTip="支持 TXT 与 JSON，导入前预览"/>
                  <Button Content="清空历史" Style="{StaticResource DangerButton}" Click="OnClearHistory"/>
                </StackPanel>
                <Border Background="#F1F5F9" CornerRadius="10" Padding="12,10" Margin="0,12,0,0">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="HistoryStatusDot" Width="10" Height="10" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="HistoryStatusText" Style="{StaticResource SettingRowLabel}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- 热键与悬停 -->
          <StackPanel x:Name="PanelHotkey" Visibility="Collapsed">
            <TextBlock Text="热键与悬停" Style="{StaticResource SettingPageTitle}" Margin="0,0,0,16"/>
            <Border Style="{StaticResource SectionBorder}">
              <StackPanel>
                <TextBlock Text="翻译热键" Style="{StaticResource SettingSectionHeader}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                  <TextBox x:Name="HotkeyBox" Width="200" IsReadOnly="True" Margin="0,0,8,0" VerticalAlignment="Center"/>
                  <Button Content="按下录制" VerticalAlignment="Center" Click="OnRecordHotkey"/>
                  <Button Content="恢复默认" Margin="8,0,0,0" VerticalAlignment="Center" Click="OnResetHotkey"/>
                </StackPanel>
                <TextBlock x:Name="HotkeyHintText" Style="{StaticResource SettingSmallHint}" Margin="0,0,0,16"/>
                <CheckBox x:Name="TranslateOnSelectionCheck" Content="选中后自动翻译（无需按热键，自动英↔中）"
                          Margin="0,0,0,6"/>
                <CheckBox x:Name="TranslateOnCopyCheck" Content="复制后自动翻译（Ctrl+C 触发，自动英↔中）"/>
                <Grid Style="{StaticResource SettingFormRow}" Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="16"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource SettingToolbarLabelHost}">
                    <TextBlock Text="翻译方向" Style="{StaticResource SettingToolbarLabel}"/>
                  </Border>
                  <ComboBox x:Name="TranslationDirectionCombo" Grid.Column="2" Width="220"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            DisplayMemberPath="Label" SelectedValuePath="Id"/>
                </Grid>
                <TextBlock Style="{StaticResource SettingSmallHint}" Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Text="自动：选中/复制/热键统一逻辑——英文→中文，中文→英文。悬停对 Electron 类软件仍可能无效。"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SectionBorder}">
              <StackPanel>
                <TextBlock Text="截屏翻译（OCR）" Style="{StaticResource SettingSectionHeader}"/>
                <TextBlock Style="{StaticResource SettingSmallHint}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="用于无法选中复制的画面。仅在你按键或点击下方按钮时截屏，不会后台扫描。"/>
                <CheckBox x:Name="EnableScreenshotHotkeyCheck" Content="启用框选截屏热键" Margin="0,0,0,8"/>
                <TextBlock Text="截屏热键" Style="{StaticResource SettingFieldLabel}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                  <TextBox x:Name="ScreenshotHotkeyBox" Width="200" IsReadOnly="True" Margin="0,0,8,0" VerticalAlignment="Center"/>
                  <Button Content="按下录制" VerticalAlignment="Center" Click="OnRecordScreenshotHotkey"/>
                  <Button Content="恢复默认" Margin="8,0,0,0" VerticalAlignment="Center" Click="OnResetScreenshotHotkey"/>
                </StackPanel>
                <CheckBox x:Name="HideSettingsForScreenshotPickCheck" Content="框选前自动隐藏设置窗口（便于全屏框选）"
                          Margin="0,0,0,8" IsChecked="True"/>
                <Button Content="立即框选截屏翻译" HorizontalAlignment="Left" Click="OnScreenshotRegionNow"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SectionBorder}">
              <StackPanel>
                <TextBlock Text="悬停翻译" Style="{StaticResource SettingSectionHeader}"/>
                <CheckBox x:Name="EnableHoverCheck" Content="启用悬停翻译"/>
                <TextBlock Style="{StaticResource SettingSmallHint}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="悬停优先读取整行/段落英文（非单词）；Electron/PDF 等可能仍无效，请用热键、复制或上方「截屏翻译（OCR）」。"/>
                <Grid Style="{StaticResource SettingFormRow}" Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="16"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource SettingToolbarLabelHost}">
                    <TextBlock Text="悬停延迟 (ms)" Style="{StaticResource SettingToolbarLabel}"/>
                  </Border>
                  <TextBox x:Name="HoverDelayBox" Grid.Column="2" Width="100"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- 通用 -->
          <StackPanel x:Name="PanelGeneral" Visibility="Collapsed">
            <TextBlock Text="通用" Style="{StaticResource SettingPageTitle}" Margin="0,0,0,4"/>
            <TextBlock Style="{StaticResource SettingHintText}" Margin="0,0,0,16"
                       Text="全局外观与启动行为；浮窗页可分别调译文/历史透明度。"/>
            <Border Style="{StaticResource SectionBorder}">
              <StackPanel>
                <TextBlock Text="外观" Style="{StaticResource SettingSectionHeader}"/>
                <Grid Style="{StaticResource SettingFormRow}" Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="16"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource SettingToolbarLabelHost}">
                    <TextBlock Text="浮窗主题" Style="{StaticResource SettingToolbarLabel}"/>
                  </Border>
                  <ComboBox x:Name="GeneralThemeCombo" Grid.Column="2" Width="220"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            DisplayMemberPath="Label" SelectedValuePath="Id"
                            SelectionChanged="OnGeneralThemeChanged"/>
                </Grid>
                <TextBlock Text="浮窗字号" Style="{StaticResource SettingRowLabel}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <Slider x:Name="GeneralFontScaleSlider" Minimum="90" Maximum="200" Width="220"
                          TickFrequency="1" IsSnapToTickEnabled="True"/>
                  <TextBox x:Name="GeneralFontScaleBox" Width="52" Margin="8,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource FrostCompactTextBox}" MaxLength="3"
                           LostFocus="OnGeneralFontScaleBoxLostFocus"
                           PreviewKeyDown="OnOpacityBoxPreviewKeyDown"/>
                  <TextBlock Text="%" Style="{StaticResource SettingRowLabel}" Margin="4,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <Button Content="标准" Tag="100" Padding="8,4" Margin="0,0,6,0" Click="OnGeneralFontScalePreset"/>
                  <Button Content="较大" Tag="130" Padding="8,4" Margin="0,0,6,0" Click="OnGeneralFontScalePreset"/>
                  <Button Content="大" Tag="160" Padding="8,4" Margin="0,0,6,0" Click="OnGeneralFontScalePreset"/>
                  <Button Content="特大" Tag="200" Padding="8,4" Click="OnGeneralFontScalePreset"/>
                </StackPanel>
                <Grid Style="{StaticResource SettingFormRow}" Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="16"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource SettingToolbarLabelHost}">
                    <TextBlock Text="浮窗字体" Style="{StaticResource SettingToolbarLabel}"/>
                  </Border>
                  <ComboBox x:Name="GeneralFontFamilyCombo" Grid.Column="2" Width="220"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            DisplayMemberPath="Label" SelectedValuePath="Id"
                            SelectionChanged="OnGeneralFontFamilyChanged"/>
                </Grid>
                <TextBlock Style="{StaticResource SettingSmallHint}" TextWrapping="Wrap"
                           Text="保存后同步到译文窗与历史窗；译文/历史页可单独调透明度。右键浮窗正文可复制、全选。"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SectionBorder}">
              <StackPanel>
                <TextBlock Text="行为" Style="{StaticResource SettingSectionHeader}"/>
                <CheckBox x:Name="CloseAfterSaveCheck" Content="保存后自动关闭设置窗口"/>
                <TextBlock Style="{StaticResource SettingSmallHint}" Margin="24,2,0,12" TextWrapping="Wrap"
                           Text="不勾选时保存后仍保持打开，配置会立即生效。"/>
                <CheckBox x:Name="ShowStartupNoticeCheck" Content="启动时显示简要提示"/>
                <TextBlock Style="{StaticResource SettingSmallHint}" Margin="24,2,0,0" TextWrapping="Wrap"
                           Text="详细用法见「关于 → 功能介绍」。"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- 隐私 -->
          <StackPanel x:Name="PanelPrivacy" Visibility="Collapsed">
            <TextBlock Text="隐私" Style="{StaticResource SettingPageTitle}" Margin="0,0,0,4"/>
            <TextBlock Style="{StaticResource SettingHintText}" Margin="0,0,0,16"
                       Text="本地数据处理、出境说明与您的数据控制权。"/>
            <Border Style="{StaticResource SectionBorder}">
              <StackPanel>
                <TextBlock Text="发送前保护" Style="{StaticResource SettingSectionHeader}"/>
                <CheckBox x:Name="SanitizeCheck" Content="自动脱敏"/>
                <TextBlock Style="{StaticResource SettingSmallHint}" Margin="24,2,0,12" TextWrapping="Wrap"
                           Text="翻译请求发出前，掩码疑似 API Key、Token、邮箱等片段。"/>
                <TextBlock Style="{StaticResource SettingSmallHint}" TextWrapping="Wrap" Foreground="#1E40AF"
                           Text="待翻译正文会发往您在「翻译接口」中配置的服务商；境外节点可能涉及数据出境，费用按服务商计费。"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SectionBorder}">
              <StackPanel>
                <TextBlock Text="本地数据" Style="{StaticResource SettingSectionHeader}" Margin="0,0,0,8"/>
                <TextBlock Style="{StaticResource SettingSmallHint}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="历史记录默认仅存本机 SQLite；截屏 OCR 仅在您主动框选时执行。"/>
                <Button Content="打开配置目录" HorizontalAlignment="Left" Click="OnOpenConfigDir"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SectionBorder}">
              <StackPanel>
                <TextBlock Text="政策与合规" Style="{StaticResource SettingSectionHeader}" Margin="0,0,0,8"/>
                <WrapPanel>
                  <Button Content="隐私政策" Margin="0,0,8,8" Click="OnOpenPrivacy"/>
                  <Button Content="用户协议" Margin="0,0,8,8" Click="OnOpenTerms"/>
                  <Button Content="AI 合规说明" Margin="0,0,8,8" Click="OnOpenComplianceMemo"/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- 关于 -->
          <StackPanel x:Name="PanelAbout" Visibility="Collapsed">
            <TextBlock Text="关于" Style="{StaticResource SettingPageTitle}" Margin="0,0,0,16"/>
            <Border Style="{StaticResource SectionBorder}">
              <StackPanel>
                <TextBlock x:Name="AboutVersionText" Style="{StaticResource SettingHintText}" Margin="0,0,0,12"/>
                <WrapPanel Margin="0,0,0,8">
                  <Button Content="功能介绍" Margin="0,0,8,8" Click="OnOpenFeatureGuide"/>
                  <Button Content="检查更新" Margin="0,0,8,8" Click="OnCheckUpdate"/>
                  <Button Content="导出诊断包" Margin="0,0,8,8" Click="OnExportDiagnostics"/>
                </WrapPanel>
                <TextBlock Style="{StaticResource SettingSmallHint}" TextWrapping="Wrap"
                           Text="诊断包为脱敏日志与配置，不含 API Key。法律文档见「隐私」页。"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>

    <!-- 底栏 -->
    <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Background="#FAFBFC" BorderBrush="#E8EDF5" BorderThickness="0,1,0,0" Padding="20,12">
      <DockPanel>
        <TextBlock x:Name="SaveHintText" Style="{StaticResource SettingHintText}" VerticalAlignment="Center"
                   DockPanel.Dock="Left" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
          <Button Content="取消" Width="80" Margin="0,0,8,0" Click="OnClose"/>
          <Button Content="保存" Width="88" Style="{StaticResource PrimaryButton}" Click="OnSave"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
