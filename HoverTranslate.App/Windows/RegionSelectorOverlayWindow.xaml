<Window x:Class="HoverTranslate.App.Windows.RegionSelectorOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Cursor="Cross"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI">
  <Grid>
    <Canvas x:Name="RootCanvas" Background="#66000000">
      <Border x:Name="SelectionBorder" BorderBrush="#2563EB" BorderThickness="2"
              Background="#332563EB" Visibility="Collapsed" IsHitTestVisible="False"/>
    </Canvas>
    <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,24,0,0"
            Background="#CC0F172A" CornerRadius="8" Padding="16,10">
      <TextBlock Foreground="White" FontSize="13" TextAlignment="Center"
                 Text="拖选要翻译的区域 · Enter 确认 · Esc 取消"/>
    </Border>
  </Grid>
</Window>
