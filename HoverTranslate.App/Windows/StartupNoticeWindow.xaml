<Window x:Class="HoverTranslate.App.Windows.StartupNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="炫译"
        Width="420" Height="220"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        Background="White"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        FontSize="14"
        UseLayoutRounding="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/SettingsFrostTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="Button" BasedOn="{StaticResource FrostButton}"/>
      <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FrostPrimaryButton}"/>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="炫译 已启动" Style="{StaticResource SettingPageTitle}" Foreground="#2563EB"/>
    <StackPanel Grid.Row="1" Margin="0,10,0,10">
      <TextBlock TextWrapping="Wrap" Style="{StaticResource SettingHintText}" LineHeight="20"
                 Text="程序在任务栏右下角托盘运行。找不到图标请点击 ^ 展开。"/>
      <TextBlock x:Name="BuildStampText" Margin="0,8,0,0" FontSize="11" Foreground="#64748B"/>
    </StackPanel>
    <DockPanel Grid.Row="2" LastChildFill="False">
      <CheckBox x:Name="DontShowAgainCheck" Content="下次不再提示" VerticalAlignment="Center"
                DockPanel.Dock="Left"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
        <Button Content="功能介绍" Padding="12,6" Margin="0,0,6,0" Click="OnShowFeatureGuide"/>
        <Button Content="设置" Padding="12,6" Margin="0,0,6,0" Click="OnOpenSettings"/>
        <Button Content="知道了" Padding="12,6" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
