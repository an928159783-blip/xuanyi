<Window x:Class="HoverTranslate.App.Windows.StartupNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="炫译"
        Width="420" Height="240"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        Background="#1E1E2E">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="炫译 已启动" FontSize="18" FontWeight="SemiBold" Foreground="#7DD3FC"/>
    <TextBlock Grid.Row="1" Margin="0,12,0,12" TextWrapping="Wrap" Foreground="#CBD5E1" FontSize="13"
               Text="本程序没有传统主窗口，运行在任务栏右下角托盘区。&#x0a;若看不到图标，请点击任务栏右侧的 ^ 展开隐藏图标。&#x0a;右键托盘图标可翻译、打开设置或退出。"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <CheckBox x:Name="DontShowAgainCheck" Content="下次不再提示" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <Button Content="打开设置" Padding="14,6" Margin="0,0,8,0" Click="OnOpenSettings"/>
      <Button Content="知道了" Padding="14,6" IsDefault="True" Click="OnOk"/>
    </StackPanel>
  </Grid>
</Window>
